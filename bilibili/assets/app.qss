QWidget#AppRoot {
    background: #f5f6f8;
    color: #1f2430;
    font-family: "Microsoft YaHei UI", "Segoe UI";
    font-size: 13px;
}
QDialog {
    background: #f5f6f8;
    color: #1f2430;
    font-family: "Microsoft YaHei UI", "Segoe UI";
    font-size: 13px;
}
QLabel {
    color: #1f2430;
    background: transparent;
}

/* ---------------- Header ---------------- */
QWidget#Header {
    background: #ffffff;
    border-bottom: 1px solid #e4e7ec;
}
QLabel#LogoBadge {
    background: transparent;
    border: none;
}
QLabel#AppTitle {
    color: #16191f;
    font-size: 16px;
    font-weight: 700;
}
QLabel#AppCaption {
    color: #9aa1ab;
    font-size: 9px;
    font-weight: 700;
}
QPushButton#HeaderButton {
    min-height: 32px;
    color: #3a4049;
    background: #ffffff;
    border: 1px solid #d7dbe2;
    font-weight: 600;
}
QPushButton#HeaderButton:hover {
    color: #16191f;
    background: #f6f7f9;
    border-color: #c2c8d1;
}
QPushButton#HeaderButton:pressed {
    background: #eef0f3;
}

/* ---------------- Sidebar ---------------- */
QWidget#Sidebar {
    background: #ffffff;
    border-right: 1px solid #e4e7ec;
}
QWidget#SidebarRail {
    background: #f0f1f4;
    border: none;
}
QPushButton#RailButton {
    padding: 0;
    border: none;
    border-radius: 6px;
    background: transparent;
}
QPushButton#RailButton:hover {
    background: #e4e7ec;
}
QPushButton#RailButton:pressed {
    background: #d8dce2;
}
QLabel#SidebarSection {
    color: #9aa1ab;
    font-size: 10px;
    font-weight: 700;
    padding-left: 11px;
}
QPushButton#NavButton {
    min-height: 38px;
    color: #4c535e;
    background: transparent;
    border: 1px solid transparent;
    border-left: 3px solid transparent;
    border-radius: 6px;
    padding: 0 10px;
    text-align: left;
    font-weight: 600;
}
QPushButton#NavButton:hover {
    color: #16191f;
    background: #f2f4f7;
}
QPushButton#NavButton:checked {
    color: #d94f7c;
    background: #fdeef4;
    border: 1px solid transparent;
    border-left: 3px solid #fb7299;
    font-weight: 700;
}

/* ---------------- Workspace ---------------- */
QLabel#PageTitle {
    color: #16191f;
    font-size: 20px;
    font-weight: 800;
}
QFrame#MetricCard {
    background: #ffffff;
    border: 1px solid #e4e7ec;
    border-radius: 8px;
}
QLabel#MetricLabel {
    color: #8b919d;
    font-size: 11px;
    font-weight: 600;
}
QLabel#MetricValue {
    color: #1f2430;
    font-size: 15px;
    font-weight: 700;
}
QLabel#MetricValueAccent {
    color: #d94f7c;
    font-size: 15px;
    font-weight: 700;
}
QLabel#ExecutionSummary {
    color: #3a4049;
    background: #f6f7f9;
    border: 1px solid #e9ecf1;
    border-radius: 6px;
    padding: 10px 12px;
    font-size: 12px;
    font-weight: 600;
}
QToolButton#AdvancedToggle {
    color: #6b7280;
    background: transparent;
    border: none;
    padding: 3px 2px;
    font-size: 11px;
    font-weight: 600;
}
QToolButton#AdvancedToggle:hover {
    color: #d94f7c;
}
QLabel#OutputPath {
    color: #5f6673;
    background: #f6f7f9;
    border: 1px solid #e9ecf1;
    border-radius: 6px;
    padding: 6px 9px;
    font-size: 11px;
    font-weight: 600;
}
QLabel#SideOutputCount {
    color: #1f2430;
    font-size: 15px;
    font-weight: 700;
}
QLabel#PreviewMeta {
    color: #6b7280;
    font-size: 11px;
}

/* ---------------- Group boxes ---------------- */
QGroupBox {
    border: 1px solid #e4e7ec;
    border-radius: 8px;
    background: #ffffff;
    margin-top: 10px;
    padding: 16px 16px 14px 16px;
    font-weight: 700;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 20px;
    padding: 0 6px;
    color: #5f6673;
    background: #ffffff;
    font-size: 12px;
    font-weight: 700;
}
QGroupBox#SideOutput {
    border-top: 2px solid #fb7299;
}
QGroupBox QLabel {
    color: #5f6673;
    font-size: 12px;
    font-weight: 600;
}

/* ---------------- Inputs ---------------- */
QLineEdit, QComboBox, QSpinBox {
    min-height: 32px;
    border: 1px solid #d7dbe2;
    border-radius: 6px;
    background: #ffffff;
    color: #1f2430;
    padding: 0 10px;
    selection-background-color: #fb7299;
    selection-color: #ffffff;
}
QLineEdit:hover, QComboBox:hover, QSpinBox:hover {
    border-color: #c2c8d1;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
    border-color: #fb7299;
}
QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled {
    background: #f5f6f8;
    color: #aab0b9;
}
QSpinBox {
    padding-right: 28px;
}
QSpinBox#CompactSpin {
    padding: 0 10px;
}
QSpinBox::up-button,
QSpinBox::down-button {
    subcontrol-origin: border;
    width: 22px;
    background: #f6f7f9;
    border: none;
    border-left: 1px solid #e4e7ec;
}
QSpinBox::up-button {
    subcontrol-position: top right;
    border-bottom: 1px solid #e4e7ec;
    border-top-right-radius: 5px;
}
QSpinBox::down-button {
    subcontrol-position: bottom right;
    border-bottom-right-radius: 5px;
}
QSpinBox::up-arrow {
    image: url("__SPIN_UP_ARROW__");
    width: 10px;
    height: 10px;
}
QSpinBox::down-arrow {
    image: url("__SPIN_DOWN_ARROW__");
    width: 10px;
    height: 10px;
}
QSpinBox::up-button:hover,
QSpinBox::down-button:hover {
    background: #eef0f3;
}
QSpinBox::up-button:pressed,
QSpinBox::down-button:pressed {
    background: #e4e7ec;
}
QComboBox::drop-down {
    border: none;
    width: 26px;
}
QComboBox::down-arrow {
    image: url("__COMBO_DOWN_ARROW__");
    width: 10px;
    height: 10px;
}
QComboBox QAbstractItemView {
    background: #ffffff;
    color: #1f2430;
    border: 1px solid #d7dbe2;
    border-radius: 6px;
    padding: 4px;
    outline: none;
    selection-background-color: #fb7299;
    selection-color: #ffffff;
}
QComboBox QAbstractItemView::item {
    min-height: 26px;
    padding: 0 8px;
    border-radius: 4px;
}
QComboBox QAbstractItemView::item:hover {
    background: #fdeef4;
    color: #1f2430;
}
QComboBox QAbstractItemView::item:selected {
    background: #fb7299;
    color: #ffffff;
}
QCheckBox {
    color: #3a4049;
    spacing: 6px;
    font-size: 12px;
    background: transparent;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #c2c8d1;
    border-radius: 4px;
    background: #ffffff;
}
QCheckBox::indicator:hover {
    border-color: #fb7299;
}
QCheckBox::indicator:checked {
    background: #fb7299;
    border-color: #fb7299;
    image: url("__CHECK_MARK__");
}
QCheckBox::indicator:checked:hover {
    background: #ee5d8a;
    border-color: #ee5d8a;
}

/* ---------------- Buttons ---------------- */
QPushButton {
    min-height: 32px;
    padding: 0 14px;
    border: 1px solid #d7dbe2;
    border-radius: 6px;
    background: #ffffff;
    color: #3a4049;
    font-weight: 600;
}
QPushButton:hover {
    background: #f6f7f9;
    border-color: #c2c8d1;
}
QPushButton:pressed {
    background: #eef0f3;
}
QPushButton:disabled {
    background: #f3f4f6;
    color: #b3b8c0;
    border-color: #e6e8ec;
}
QPushButton#PrimaryButton {
    background: #fb7299;
    color: #ffffff;
    border: 1px solid #fb7299;
    font-weight: 700;
    padding: 0 20px;
}
QPushButton#PrimaryButton:hover {
    background: #ee5d8a;
    border-color: #ee5d8a;
}
QPushButton#PrimaryButton:pressed {
    background: #dd4d7b;
    border-color: #dd4d7b;
}
QPushButton#StopButton {
    background: #d15c5c;
    color: #ffffff;
    border-color: #d15c5c;
    font-weight: 700;
}
QPushButton#StopButton:hover {
    background: #bf4c4c;
    border-color: #bf4c4c;
}
QPushButton#PrimaryButton:disabled,
QPushButton#StopButton:disabled,
QPushButton#HeaderButton:disabled {
    background: #f3f4f6;
    color: #b3b8c0;
    border-color: #e6e8ec;
}

/* ---------------- Text areas ---------------- */
QPlainTextEdit {
    border: 1px solid #232833;
    border-radius: 8px;
    background: #1b1f27;
    color: #dfe3e8;
    padding: 12px;
    selection-background-color: #fb7299;
}
QPlainTextEdit#CommandPreview {
    background: #f6f7f9;
    color: #3a4049;
    border: 1px solid #e9ecf1;
    border-radius: 6px;
    padding: 10px 11px;
    font-size: 12px;
}
QPlainTextEdit#FullContentEdit {
    background: #ffffff;
    color: #2a3038;
    border: 1px solid #e4e7ec;
    border-radius: 8px;
    padding: 14px;
    selection-background-color: #f9c4d5;
    selection-color: #2a3038;
}
QPlainTextEdit#VideoDescription {
    background: #f6f7f9;
    color: #3a4049;
    border: 1px solid #e4e7ec;
    border-radius: 8px;
    padding: 10px;
    selection-background-color: #f9c4d5;
    selection-color: #2a3038;
}

/* ---------------- Tables ---------------- */
QTableWidget, QTableView {
    background: #ffffff;
    alternate-background-color: #f8f9fa;
    border: 1px solid #e4e7ec;
    border-radius: 6px;
    color: #353b44;
    gridline-color: #eef0f3;
    selection-background-color: #fdeef4;
    selection-color: #6b2440;
}
QTableWidget::item, QTableView::item {
    padding: 5px;
}
QHeaderView::section {
    background: #f6f7f9;
    color: #5f6673;
    border: none;
    border-bottom: 1px solid #e4e7ec;
    padding: 7px;
    font-weight: 700;
}

/* ---------------- Misc ---------------- */
QLabel#ReportSection {
    color: #3a4049;
    font-size: 14px;
    font-weight: 800;
}
QFrame#VideoInfoPanel {
    background: #f6f7f9;
    border: 1px solid #e4e7ec;
    border-radius: 8px;
}
QLabel#VideoInfoLabel {
    color: #8b919d;
    font-size: 10px;
    font-weight: 700;
}
QLabel#VideoInfoValue {
    color: #333943;
    font-size: 12px;
    font-weight: 700;
}
QFrame#LogEmpty {
    background: #ffffff;
    border: 1px solid #e4e7ec;
    border-radius: 8px;
}
QLabel#EmptyTitle {
    color: #333943;
    font-size: 17px;
    font-weight: 800;
}
QLabel#EmptyCaption {
    color: #8b919d;
    font-size: 12px;
}

/* ---------------- Completion dialog ---------------- */
QDialog#CompletionDialog {
    background: #ffffff;
}
QLabel#CompletionBadge {
    color: #ffffff;
    background: #fb7299;
    border-radius: 23px;
    font-size: 24px;
    font-weight: 800;
}
QLabel#CompletionTitle {
    color: #16191f;
    font-size: 19px;
    font-weight: 800;
}
QLabel#CompletionMessage {
    color: #5f6673;
    font-size: 13px;
    font-weight: 600;
}
QFrame#CompletionPanel {
    background: #f6f7f9;
    border: 1px solid #e4e7ec;
    border-radius: 8px;
}
QLabel#CompletionPanelLabel {
    color: #8b919d;
    font-size: 10px;
    font-weight: 700;
}
QLabel#CompletionPath {
    color: #353b44;
    font-size: 12px;
    font-weight: 600;
}

/* ---------------- Status / progress ---------------- */
QProgressBar {
    border: none;
    background: transparent;
    max-height: 3px;
}
QProgressBar::chunk {
    background: #fb7299;
}
QStatusBar {
    background: #ffffff;
    color: #6b7280;
    border-top: 1px solid #e4e7ec;
}

/* ---------------- Scrollbars ---------------- */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
    border: none;
}
QScrollBar::handle:vertical {
    background: #cbd0d7;
    border-radius: 5px;
    min-height: 36px;
    margin: 2px;
}
QScrollBar::handle:vertical:hover {
    background: #aab0b9;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0;
    border: none;
}
QScrollBar::handle:horizontal {
    background: #cbd0d7;
    border-radius: 5px;
    min-width: 36px;
    margin: 2px;
}
QScrollBar::handle:horizontal:hover {
    background: #aab0b9;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
    height: 0;
    background: transparent;
    border: none;
}
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
}
